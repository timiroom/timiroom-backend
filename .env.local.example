# ──────────────────────────────────────────────────────────────
# timiroom-backend 환경변수 템플릿
# 복사 후 .env.local 로 저장하고 값을 채우세요.
# cp .env.local.example .env.local
# ──────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/timiroom
DB_USERNAME=
DB_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────\
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# ── OAuth2 — GitHub ───────────────────────────────────────────\
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ── OAuth2 — Google ───────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── MinIO (오브젝트 스토리지) ──────────────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin1234
STORAGE_BUCKET=timiroom
STORAGE_PUBLIC_URL=http://localhost:9000

# ── GitHub App (timiroom 연동) ────────────────────────────────
# App ID: GitHub 조직 Settings > Developer settings > GitHub Apps > timiroom
# private key(.pem)는 팀 내부에서 공유받아 .secrets/ 폴더에 두세요 (git 제외됨)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=.secrets/timiroom.private-key.pem
GITHUB_WEBHOOK_SECRET=
